<h1>Reservar en <%= @club.name %></h1>

<%= form_with(model: [@club, @reservation], url: club_reservations_path(@club), method: :post) do |f| %>
  <%= f.hidden_field :current_date %>
  <%= f.hidden_field :start_time %>
  <%= f.hidden_field :end_time %>

  <p><strong>Fecha:</strong> <%= l(@reservation.current_date, format: :long) %></p>
  <p><strong>Horario:</strong> <%= @reservation.start_time.strftime("%H:%M") %> - <%= @reservation.end_time.strftime("%H:%M") %></p>

  <div class="field">
    <%= f.label :court_id, "Seleccionar Cancha Libre" %>
    <%= f.collection_select :court_id, @available_courts, :id, :description, prompt: "Elige una cancha" %>
  </div>

  <div class="actions">
    <%= f.submit "Confirmar Reserva" %>
  </div>
<% end %>