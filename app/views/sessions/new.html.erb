
<div class="auth-container">
  <div class="auth-card">
    <h1 class="auth-title">Iniciar sesión</h1>
    <p class="auth-subtitle">Ingresá a tu cuenta para continuar</p>

    <% if flash[:alert] %>
      <div class="auth-message auth-message--error">
        <%= flash[:alert] %>
      </div>
    <% end %>

    <% if flash[:notice] %>
      <div class="auth-message auth-message--success">
        <%= flash[:notice] %>
      </div>
    <% end %>

    <%= form_with url: session_path, class: "auth-form" do |form| %>
      <div class="auth-form-group">
        <%= form.label :email_address, "Correo electrónico" %>
        <%= form.email_field :email_address,
            required: true,
            autofocus: true,
            autocomplete: "username",
            placeholder: "Ingresá tu correo",
            value: params[:email_address],
            class: "auth-input" %>
      </div>

      <div class="auth-form-group">
        <%= form.label :password, "Contraseña" %>
        <%= form.password_field :password,
            required: true,
            autocomplete: "current-password",
            placeholder: "Ingresá tu contraseña",
            maxlength: 72,
            class: "auth-input" %>
      </div>

      <%= form.submit "Ingresar", class: "auth-button" %>
    <% end %>

    <div class="auth-links">
      <%= link_to "¿Olvidaste tu contraseña?", new_password_path %>
      <%= link_to "Crear una cuenta", new_user_path %>
    </div>
  </div>
</div>
