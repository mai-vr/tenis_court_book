<section>
    <h1>
        Selected court
    </h1>

    <div>
        
            <% if policy(@court).edit? %>
                <%= link_to "Edit", edit_club_court_path(@court.club, @court) %>
            <% end %>
            <% if policy(@court).destroy? %>
                <%= button_to "Delete",club_court_path(@court.club, @court), method: :delete %>
            <% end %>
            <div>
                <h4>
                    <%= @court.club.name %>
                </h4>
                <p>
                    <%= @court.material %>
                </p>
                <p>
                    <% if @court.indoor %>
                        <p>Indoor</p>
                    <%else%>
                        <p>Outdoor</p>
                    <%end%>
                </p>
                <p>
                    $ <%= @court.price_per_hour %> per hour
                </p>
            </div>
        
    </div>
</section>