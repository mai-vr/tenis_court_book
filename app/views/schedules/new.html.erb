<section>
  <h1>Add schedule for <%= @club.name %></h1>

  <%= form_with model: [@club, @schedule] do |form| %>
    <% if @schedule.errors.any? %>
      <ul class="error">
        <% @schedule.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form.label :day_week %>
    <%= form.select :day_week, Schedule.day_weeks.keys.map { |day| [day.humanize, day] }, { prompt: "Select a day" }, required: true %>

    <%= form.label :start_time %>
    <%= form.time_field :start_time, required: true %>

    <%= form.label :end_time %>
    <%= form.time_field :end_time, required: true %>

    <%= form.submit "Save schedule" %>
  <% end %>

  <%= link_to "Cancel", club_path(@club) %>
</section>
