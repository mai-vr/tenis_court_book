<%= form_with model: club do |form| %>
  <% if club.errors.any? || location.errors.any? %>
    <ul>
      <% club.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
      <% location.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <form>
    <h3>Club</h3>
    <%= form.label :name %>
    <%= form.text_field :name, required: true %>

    <%= form.label :phone %>
    <%= form.telephone_field :phone, required: true %>

    <%= form.label :email %>
    <%= form.email_field :email %>

    <%= form.label :description %>
    <%= form.text_area :description %>

    <h3>Location</h3>
    <%= fields_for :location, location do |location_form| %>
      <%= location_form.label :street %>
      <%= location_form.text_field :street, required: true %>

      <%= location_form.label :number %>
      <%= location_form.number_field :number, min: 1, required: true %>

      <%= location_form.label :city %>
      <%= location_form.text_field :city, required: true %>
    <% end %>
  

  <%= form.submit "Guardar" %>
  </form>
<% end %>
