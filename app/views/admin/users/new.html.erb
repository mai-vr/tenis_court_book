<div class="new-user-container">
  <h1 class="new-user-title">Registrar Nuevo Admin de Club</h1>

  <%= form_with model: [:admin, @user], class: "form-user" do |f| %>
    <% if @user.errors.any? %>
      <div class="user-errors">
        <ul class="user-errors-list">
          <% @user.errors.full_messages.each do |msg| %>
            <li class="user-error-item"><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :first_name, "Nombre", class: "form-label" %><br>
      <%= f.text_field :first_name, required: true, class: "form-input form-input-email" %>
    </div>

    <div class="form-group">
      <%= f.label :last_name, "Apellido", class: "form-label" %><br>
      <%= f.text_field :last_name, required: true, class: "form-input form-input-email" %>
    </div>

    <div class="form-group">
      <%= f.label :email_address, "Correo Electrónico", class: "form-label" %><br>
      <%= f.email_field :email_address, required: true, class: "form-input form-input-email" %>
    </div>

    <div class="form-group">
      <%= f.label :password, "Contraseña", class: "form-label" %><br>
      <%= f.password_field :password, required: true, class: "form-input form-input-password" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, "Confirmar Contraseña", class: "form-label" %><br>
      <%= f.password_field :password_confirmation, required: true, class: "form-input form-input-password" %>
    </div>

    <div class="form-group">
      <%= f.label :club_id, "Club", class: "form-label" %><br>
      <%= f.text_field :club_id, required: true, class: "form-input form-input-email" %>
    </div>

    <div class="form-actions">
      <%= f.submit "Crear Club Admin", class: "btn-submit" %>
      <%= link_to "Cancelar", admin_users_path, class: "btn-cancel" %>
    </div>
  <% end %>
</div>