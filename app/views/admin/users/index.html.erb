<div class="users-management-container">
  <div class="users-management-header">
    <h1 class="users-management-title">Gestión de Usuarios</h1>
    <%= link_to "Registrar Nuevo Club Admin", new_admin_user_path, class: "btn-new-user" %>
  </div>

  <table class="users-table">
    <thead class="users-table-head">
      <tr class="users-table-header-row">
        <th class="users-table-th">Email</th>
        <th class="users-table-th">Rol</th>
        <th class="users-table-th">Estado del Club</th>
      </tr>
    </thead>
    <tbody class="users-table-body">
      <% @users.each do |user| %>
        <tr class="users-table-row">
          <td class="users-table-td users-table-td-email"><%= user.email_address %></td>
          <td class="users-table-td users-table-td-role">
            <%= user.role.humanize %>
          </td>
          <td class="users-table-td users-table-td-status">
            <% if user.club_admin? %>
              <% if user.club.present? %>
                <span class="club-status-assigned"><%= user.club.name %></span>
              <% else %>
                <span class="club-status-pending">Pendiente de cargar club</span>
              <% end %>
            <% else %>
              <span class="club-status-none">Sin club</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>