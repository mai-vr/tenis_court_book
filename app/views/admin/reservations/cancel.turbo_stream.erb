<%= turbo_stream.remove dom_id(@reservation) %>

<%= turbo_stream.append "cancelled-reservations" do %>
  <%= render "reservation", reservation: @reservation %>
<% end %>
<% if @pending_reservations.empty? %>
  <%= turbo_stream.update "pending-reservations" do %>
    <p class="reservations-empty">
      No hay reservas pendientes.
    </p>
  <% end %>
<% end %>