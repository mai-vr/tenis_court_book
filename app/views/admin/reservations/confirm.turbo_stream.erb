<%= turbo_stream.remove dom_id(@reservation) %>

<%= turbo_stream.update "confirmed-reservations" do %>
  <% if @confirmed_reservations.any? %>
    <%= render partial: "reservation",
        collection: @confirmed_reservations,
        as: :reservation %>
  <% else %>
    <p class="reservations-empty">No hay reservas confirmadas.</p>
  <% end %>
<% end %>

<% if @pending_reservations.empty? %>
  <%= turbo_stream.update "pending-reservations" do %>
    <p class="reservations-empty">No hay reservas pendientes.</p>
  <% end %>
<% end %>