<section class="reservation-show-section">
  <h1 class="reservation-show-title">¡Reserva confirmada!</h1>

  <div class="reservation-card">
    <p class="reservation-detail">
      <strong class="reservation-detail-label">Estado</strong>
      <span class="reservation-status"><%= @reservation.status.titleize %></span>
    </p>
    <p class="reservation-detail">
      <strong class="reservation-detail-label">Club</strong>
      <%= @club.name %>
    </p>
    <p class="reservation-detail">
      <strong class="reservation-detail-label">Cancha</strong>
      <%= @reservation.court.description %>
    </p>
    <p class="reservation-detail">
      <strong class="reservation-detail-label">Fecha</strong>
      <%= l(@reservation.current_date, format: :long) rescue @reservation.current_date %>
    </p>
    <p class="reservation-detail">
      <strong class="reservation-detail-label">Horario</strong>
      <%= @reservation.start_time.strftime("%H:%M") rescue @reservation.start_time %> - <%= @reservation.end_time.strftime("%H:%M") rescue @reservation.end_time %>
    </p>

    <% if @reservation.payment %>
      <div class="reservation-payment">
        <p class="reservation-detail">
          <strong class="reservation-detail-label">Método de pago</strong>
          <%= @reservation.payment.payment_method.titleize %>
        </p>
        <p class="reservation-detail">
          <strong class="reservation-detail-label">Monto pagado</strong>
          <span class="reservation-detail-total"><%= number_to_currency(@reservation.payment.total) %></span>
        </p>
      </div>
    <% end %>
  </div>

  <%= link_to "Volver al club", admin_club_path(@club), class: "btn-back" %>
</section>