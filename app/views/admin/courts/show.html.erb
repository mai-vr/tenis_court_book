<section class="court-show-section">
  <h1 class="court-show-title">
    Selected court
  </h1>
  <div class="court-navigation">
    <%= link_to "Volver al club", admin_club_path(@court.club), class: "btn-back" %>
  </div>
  <div class="court-details-container">
    <div class="court-actions">
      <% if policy(@court).edit? %>
        <%= link_to "Edit", edit_admin_club_court_path(@court.club, @court), class: "btn-edit" %>
      <% end %>
      <% if policy(@court).destroy? %>
        <%= button_to "Delete", admin_club_court_path(@court.club, @court), method: :delete, class: "btn-delete" %>
      <% end %>
    </div>
    <div class="court-info-card">
      <h4 class="court-club-name">
        <%= @court.club.name %>
      </h4>
      <p class="court-material">
        <%= @court.material %>
      </p>
      <div class="court-environment">
        <% if @court.indoor %>
          <p class="court-environment-text">Indoor</p>
        <% else %>
          <p class="court-environment-text">Outdoor</p>
        <% end %>
      </div>
      <p class="court-price">
        $ <%= @court.price_per_hour %> per hour
      </p>
    </div>
  </div>
</section>