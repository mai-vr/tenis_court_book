<section class="club-details-section">
  <%= link_to "Volver", admin_clubs_path, class: "btn-back" %>

  <div class="club-header">
    <% if @club.logo.attached? %>
      <%= image_tag @club.logo, alt: "Logo del club", class: "club-logo" %>
    <% else %>
      <%= image_tag "default_logo.jpg", alt: "Sin logo", class: "club-logo club-logo-default" %>
    <% end %>

    <h1 class="club-title"><%= @club.name %></h1>
    <p class="club-description"><%= @club.description %></p>
    <p class="club-address"><%= @club.location.street %> <%= @club.location.number %>, <%= @club.location.city %></p>
    <p class="club-contact">
      <%= @club.phone %> <% if @club.email.present? %>· <%= @club.email %><% end %>
    </p>

    <% if policy(@club).edit? %>
      <p class="club-actions">
        <%= link_to "Editar club", edit_admin_club_path(@club), class: "btn-edit-club" %>
      </p>
    <% end %>
  </div>

  <h2 class="section-title">Horarios del Club</h2>
  <% if policy(Schedule).new? %>
    <%= link_to "Agregar horarios", new_admin_club_schedule_path(@club), class: "btn-add-schedule" %>
  <% end %>

  <% if @schedules.any? %>
    <ul class="schedules-list">
      <% @schedules.each do |schedule| %>
        <li class="schedule-item">
          <%= schedule.day_week.humanize %>: <%= schedule.start_time.strftime("%H:%M") %> - <%= schedule.end_time.strftime("%H:%M") %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state-text">No hay horarios cargados.</p>
  <% end %>

  <hr class="section-divider">

  <h2 class="section-title">Canchas</h2>
  <% if policy(Court).new? %>
    <%= link_to "Agregar cancha", new_admin_club_court_path(@club), class: "btn-add-court" %>
  <% end %>

  <% if @club.courts.any? %>
    <ul class="courts-list">
      <% @club.courts.each do |court| %>
        <li class="court-item">
          <strong class="court-name"><%= court.description %></strong> — 
          <span class="court-price">$<%= court.price_per_hour %>/hs</span> | 
          <span class="court-surface"><%= court.material %></span> | 
          <span class="court-type"><%= court.indoor? ? "Cubierta (Indoor)" : "Descubierta" %></span> | 
          
          <%# Si tenés un show/edit de court %>
          <% if policy(court).show? %>
            · <%= link_to "Ver cancha", admin_club_court_path(@club, court), class: "court-link" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state-text">No hay canchas registradas en este club.</p>
  <% end %>

  <hr class="section-divider">

  <h2 class="section-title">Reservar una cancha</h2>
  <% if @booking_slots.any? %>
    <ul class="booking-dates-list">
      <% @booking_slots.group_by { |slot| slot[:date] }.sort_by { |date, _| date }.each do |date, slots| %>
        <li class="booking-date-group">
          <strong class="booking-date"><%= l(date, format: :long) %></strong>
          <ul class="booking-slots-list">
            <% slots.each do |slot| %>
              <li class="booking-slot-item">
                <span class="booking-slot-time">
                  <%= slot[:start_time].strftime("%H:%M") %> - <%= slot[:end_time].strftime("%H:%M") %>
                </span>
                
                <% if slot[:available] %>
                  <%= link_to "Reservar", new_admin_club_reservation_path(
                    @club,
                    reservation: {
                      current_date: slot[:date],
                      start_time: slot[:start_time].strftime("%H:%M"),
                      end_time: slot[:end_time].strftime("%H:%M")
                    }
                  ), class: "btn-reserve-slot" %>
                  <small class="available-courts-count">(Canchas disponibles: <%= slot[:available_courts].count %>)</small>
                <% else %>
                  <span class="slot-unavailable">No disponible</span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="empty-state-text">No hay bloques disponibles para reservar.</p>
  <% end %>
</section>