<section>
  <h1>Clubs</h1>

  <% if policy(Club).new? %>
    <%= link_to "Nuevo club", new_admin_club_path %>
  <% end %>

  <% @clubs.each do |club| %>
    <article>
      <h2><%= link_to club.name, admin_club_path(club) %></h2>
      <p><%= club.description %></p>
      <p><%= club.location.street %> <%= club.location.number %>, <%= club.location.city %></p>
      <h3>Horarios</h3>
      <% if club.schedules.any? %>
        <ul>
          <% club.schedules.sort_by { |schedule| [schedule.day_week_before_type_cast, schedule.start_time] }.each do |schedule| %>
            <li>
              <%= schedule.day_week.humanize %>:
              <%= schedule.start_time.strftime("%H:%M") %> -
              <%= schedule.end_time.strftime("%H:%M") %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p>No hay horarios cargados.</p>
      <% end %>
    </article>
  <% end %>
</section>
