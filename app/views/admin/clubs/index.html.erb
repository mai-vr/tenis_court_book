<section class="clubs-section">
  <h1 class="clubs-title">Clubs</h1>

  <% if policy(Club).new? %>
    <%= link_to "Nuevo club", new_admin_club_path, class: "btn-new-club" %>
  <% end %>
  <% if current_user&.superadmin? %>
    <%= link_to "Ver usuarios", admin_users_path, class: "btn-new-club" %>
  <% end %>

  <% @clubs.each do |club| %>
    <article class="club-card">
      <% if club.logo.attached? %>
        <%= image_tag club.logo, class: "club-logo" %>
      <% else %>
        <%= image_tag "default_logo.jpg", class: "club-logo club-logo-default" %>
      <% end %>
      
      <h2 class="club-name">
        <%= link_to club.name, admin_club_path(club), class: "club-name-link" %>
      </h2>
      
      <p class="club-description"><%= club.description %></p>
      <p class="club-address"><%= club.location.street %> <%= club.location.number %>, <%= club.location.city %></p>
      
      <h3 class="club-schedules-title">Horarios</h3>
      
      <% if club.schedules.any? %>
        <ul class="club-schedules-list">
          <% club.schedules.sort_by { |schedule| [schedule.day_week_before_type_cast, schedule.start_time] }.each do |schedule| %>
            <li class="club-schedule-item">
              <%= schedule.day_week.humanize %>:
              <%= schedule.start_time.strftime("%H:%M") %> -
              <%= schedule.end_time.strftime("%H:%M") %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="club-schedules-empty">No hay horarios cargados.</p>
      <% end %>
    </article>
  <% end %>
</section>