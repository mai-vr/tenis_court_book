<section class="schedule-form-section">
  <h1 class="schedule-form-title">Add schedule for <%= @club.name %></h1>

  <%= form_with model: [:admin, @club, @schedule], class: "form-schedule" do |form| %>
    <% if @schedule.errors.any? %>
      <ul class="error schedule-errors-list">
        <% @schedule.errors.full_messages.each do |message| %>
          <li class="schedule-error-item"><%= message %></li>
        <% end %>
      </ul>
    <% end %>

    <%= form.label :day_week, class: "form-schedule-label" %>
    <%= form.select :day_week, Schedule.day_weeks.keys.map { |day| [day.humanize, day] }, { prompt: "Select a day" }, { required: true, class: "form-schedule-select" } %>

    <%= form.label :start_time, class: "form-schedule-label" %>
    <%= form.time_field :start_time, required: true, class: "form-schedule-input form-schedule-input-time" %>

    <%= form.label :end_time, class: "form-schedule-label" %>
    <%= form.time_field :end_time, required: true, class: "form-schedule-input form-schedule-input-time" %>

    <%= form.submit "Save schedule", class: "form-schedule-submit-btn" %>
  <% end %>

  <%= link_to "Cancel", admin_club_path(@club), class: "btn-cancel" %>
</section>