<h1 class="payment-title">Confirmar Pago y Reserva</h1>

<div class="reservation-summary">
  <p class="summary-item"><strong class="summary-label">Club:</strong> <%= @club.name %></p>
  <p class="summary-item"><strong class="summary-label">Cancha:</strong> <%= @reservation.court.description %></p>
  <p class="summary-item"><strong class="summary-label">Fecha:</strong> <%= l(@reservation.current_date, format: :long) rescue @reservation.current_date %></p>
  <p class="summary-item"><strong class="summary-label">Horario:</strong> <%= @reservation.start_time.strftime("%H:%M") rescue @reservation.start_time %> - <%= @reservation.end_time.strftime("%H:%M") rescue @reservation.end_time %></p>
  <p class="summary-item"><strong class="summary-label">Monto Total:</strong> <%= number_to_currency(@payment.total) %></p>
</div>

<%= form_with(model: [:admin, @club, @reservation, @payment], url: admin_club_reservation_payments_path(@club, @reservation), class: "form-payment") do |f| %>
  
  <% if @payment.errors.any? %>
    <div class="payment-errors">
      <h4 class="payment-errors-title">Error al procesar el pago:</h4>
      <ul class="payment-errors-list">
        <% @payment.errors.full_messages.each do |msg| %>
          <li class="payment-error-item"><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field form-field-group">
    <%= f.label :payment_method, "Seleccionar Método de Pago", class: "form-label" %>
    <%= f.select :payment_method, 
                 [
                   ['Efectivo', 'cash'], 
                   ['QR', 'qr'], 
                   ['Mercado Pago', 'mercado_pago']
                 ], 
                 { prompt: "Elige una opción" }, 
                 { class: "form-control form-select-payment" } %>
  </div>

  <div class="actions form-actions">
    <%= f.submit "Pagar y Confirmar Reserva", class: "btn-confirm-payment" %>
  </div>
<% end %>